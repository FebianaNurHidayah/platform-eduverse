{
  "version": 2,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(api|healthz)(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|healthz|sitemap\\.xml|robots\\.txt|favicon\\.ico).*)",
      "destination": "/api/index.js"
    }
  ]
}